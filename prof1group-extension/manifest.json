{
  "manifest_version": 3,
  "name": "PROF1Group Агент",
  "version": "1.0.0",
  "description": "Агент для PROF1Group: сповіщення про новинки, автозаповнення кошика, контент-план для СММ",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "scripting",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://prof1group.ua/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://prof1group.ua/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PROF1Group Агент"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
